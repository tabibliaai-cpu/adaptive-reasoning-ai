# ============================================================
# Adaptive Reasoning AI — Environment Configuration
# ============================================================

# ─── OPTION 1: Proxy to Z.ai Sandbox (easiest, no API keys needed) ───
# Set this to your Z.ai preview URL. The Netlify frontend will send
# all AI requests to the Z.ai sandbox backend.
# Example: NEXT_PUBLIC_API_URL=https://preview-abc123.space.chatglm.site
NEXT_PUBLIC_API_URL=

# ─── OPTION 2: Direct AI API (self-contained, needs API keys) ───
# If you don't set NEXT_PUBLIC_API_URL, Netlify will use its own
# backend API routes, which need these credentials:
#
# ZAI_BASE_URL=https://api.groq.com/openai/v1
# ZAI_API_KEY=gsk_your_key_here

# OPTIONAL — Extra headers sent to the AI API
# ZAI_CHAT_ID=
# ZAI_USER_ID=
# ZAI_TOKEN=
