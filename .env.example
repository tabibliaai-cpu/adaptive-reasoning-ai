# ============================================================
# Adaptive Reasoning AI — Environment Configuration
# ============================================================
# These environment variables are used when deploying to
# external platforms (Netlify, Vercel, Railway, etc.)
# where the .z-ai-config file is not available.
#
# In the Z.ai sandbox, the .z-ai-config file is used instead.
# ============================================================

# REQUIRED — Your AI API endpoint (must include /v1)
ZAI_BASE_URL=https://your-api-endpoint.com/v1

# REQUIRED — Your API key
ZAI_API_KEY=your-api-key-here

# OPTIONAL — Chat session ID (sent as X-Chat-Id header)
# ZAI_CHAT_ID=

# OPTIONAL — User identifier (sent as X-User-Id header)
# ZAI_USER_ID=

# OPTIONAL — Auth token (sent as X-Token header)
# ZAI_TOKEN=
